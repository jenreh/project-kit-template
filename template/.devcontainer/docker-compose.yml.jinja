services:
  app:
    container_name: {{ project_name }}-dev
    image: {{ project_name }}/ui-dev
    build:
      # The Dockerfile copies nothing, so only send this folder as build context
      context: .
      dockerfile: Dockerfile
      args:
        VARIANT: {{ python_version }}-trixie
    volumes:
      # Only this project: sibling repos and their .env files stay out of reach of
      # the tools and coding agents running in the container.
      - ..:/workspaces/{{ project_name }}:rw,cached
      # Survives rebuilds: uv, pre-commit and antidote caches, uv-managed Python and
      # tools{% if coding_agents %}, {{ coding_agents | join('/') }} logins and plugins{% endif %} (symlinked, see Dockerfile)
      - dev-state:/home/vscode/.persist
    command: sleep infinity
    networks:
      - {{ project_name }}-network
{%- if project_type == 'reflex' or include_db %}

  db:
    container_name: {{ project_name }}-dev-db
    image: pgvector/pgvector:0.8.7-pg18-trixie
    restart: unless-stopped
    volumes:
      # PostgreSQL 18 images keep their data in a versioned subdirectory of this path.
      - dev-postgres-data:/var/lib/postgresql
    environment:
      POSTGRES_USER: postgres
      POSTGRES_DB: {{ db_name }}
      # Development only: throwaway credentials, reachable from this machine alone.
      POSTGRES_PASSWORD: postgres
    ports:
      - "127.0.0.1:5434:5432"
    networks:
      - {{ project_name }}-network
{%- endif %}

networks:
  {{ project_name }}-network:
    driver: bridge

volumes:
  dev-state:
    name: {{ project_name }}-dev-state
{%- if project_type == 'reflex' or include_db %}
  dev-postgres-data:
    name: {{ project_name }}-dev-postgres-data
{%- endif %}
