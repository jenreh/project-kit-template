services:
  app:
    container_name: {{ project_name }}-dev
    image: {{ project_name }}/ui-dev
    build:
      context: ..
      dockerfile: .devcontainer/Dockerfile
      args:
        VARIANT: {{ python_version }}-trixie
    volumes:
      - ../..:/workspaces:rw,cached
    command: sleep infinity
    networks:
      - {{ project_name }}-network
{%- if project_type == 'reflex' or include_db %}

  db:
    container_name: {{ project_name }}-dev-db
    image: pgvector/pgvector:0.8.7-pg18-trixie
    restart: unless-stopped
    volumes:
      # PostgreSQL 18 images keep their data in a versioned subdirectory of this path.
      - dev-postgres-data:/var/lib/postgresql
    environment:
      POSTGRES_USER: postgres
      POSTGRES_DB: {{ db_name }}
      # Development only: throwaway credentials, reachable from this machine alone.
      POSTGRES_PASSWORD: postgres
    ports:
      - "127.0.0.1:5434:5432"
    networks:
      - {{ project_name }}-network
{%- endif %}

networks:
  {{ project_name }}-network:
    driver: bridge
{%- if project_type == 'reflex' or include_db %}

volumes:
  dev-postgres-data:
    name: {{ project_name }}-dev-postgres-data
{%- endif %}
