#!/bin/bash
set -eu

: "${WORKSPACE:?WORKSPACE environment variable must be set}"
cd "$WORKSPACE"
# Configure git to allow the workspace as a safe directory
git config --global --add safe.directory "$WORKSPACE"
# A ~/.gitconfig copied in from the host can point the GitHub credential helper at a
# host-only gh path; drop it so VS Code's forwarded credential helper is used
for host in https://github.com https://gist.github.com; do
	git config --global --remove-section "credential.$host" 2>/dev/null || true
done

# The volume only copies the image's folders when it is new; recreate any missing ones
mkdir -p "$HOME"/.persist/{cache,uv{% for agent in coding_agents %},{{ agent }}{% endfor %}}

echo "Setting up zsh"
cp "$WORKSPACE"/.devcontainer/.zsh_plugins.txt "$HOME"/.zsh_plugins.txt
cp "$WORKSPACE"/.devcontainer/.zshrc "$HOME"/.zshrc
# Clone the plugins now (in parallel), so the first terminal opens without a delay
zsh -i -c exit >/dev/null 2>&1 &
zsh_pid=$!
{%- if 'codex' in coding_agents %}

# Codex CLI (npm comes from the node feature); already there after a restart.
# Pinned like every other tool; bump the version here to update it.
command -v codex >/dev/null || npm install --global --no-fund --no-audit @openai/codex@0.169.0
{%- endif %}

# Installs Python, syncs deps, builds the pre-commit envs{% if coding_agents %} and installs the agent plugins{% endif %}
echo "Initializing project"
task init

wait "$zsh_pid" || echo "zsh plugin setup failed; the first terminal retries it"
