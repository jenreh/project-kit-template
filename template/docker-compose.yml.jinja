# Run with: docker compose --env-file .env.docker up --build
# Both services fail to start until .env.docker sets POSTGRES_PASSWORD and the mn-db-*
# secrets (see .env.default). All ports are bound to loopback: this file is for local
# testing, so put a TLS-terminating proxy in front of the app for anything else.
services:
  {{ project_name }}-app:
    container_name: {{ project_name }}-app
    image: {{ project_name }}-app
    build:
      context: .
      dockerfile: Dockerfile
    env_file:
      - .env.docker
    depends_on:
      db:
        condition: service_healthy
    # Put the app into the same network as the DB so it can reach the DB at host 'db'
    networks:
      - {{ project_name }}-network
    ports:
      - "127.0.0.1:8080:8080"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    develop:
      watch:
        - action: sync
          path: ./app
          target: /reflexapp/app
        - action: sync
          path: ./components
          target: /reflexapp/components
        - action: sync
          path: ./assets
          target: /reflexapp/assets
        - action: sync
          path: ./configuration
          target: /reflexapp/configuration
        - action: rebuild
          path: ./pyproject.toml
        - action: rebuild
          path: ./uv.lock
        - action: rebuild
          path: ./Dockerfile
        - action: rebuild
          path: ./start.sh

  db:
    container_name: {{ project_name }}-db
    image: pgvector/pgvector:0.8.7-pg18-trixie
    restart: unless-stopped
    volumes:
      # PostgreSQL 18 images keep their data in a versioned subdirectory of this path.
      - postgres-data:/var/lib/postgresql
    environment:
      POSTGRES_USER: postgres
      POSTGRES_DB: {{ db_name }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD in .env.docker and pass --env-file .env.docker}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ db_name }}"]
      interval: 5s
      timeout: 5s
      retries: 10
    ports:
      - "127.0.0.1:5433:5432"
    networks:
      - {{ project_name }}-network

volumes:
  postgres-data:
    name: {{ project_name }}-postgres-data
networks:
  {{ project_name }}-network:
    driver: bridge
