profile: devcontainer

reflex:
  deploy_url: http://localhost:8080
  api_url: http://localhost:3030
  frontend_port: 8080
  backend_port: 3030
  workers: 1

app:
  environment: devcontainer
  logging: logging.yaml

  database:
    host: db
    port: 5432
    echo: False # True also logs bound values such as password hashes and tokens
    name: {{ db_name }}

  authentication:
    server_url: http://localhost
    server_port: 8080

    # Leave redirect_url unset: it is derived from server_url and frontend_path.
