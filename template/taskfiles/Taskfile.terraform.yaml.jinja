{%- set cloud = 'AWS' if cloud_provider == 'aws' else 'Azure' -%}
# yaml-language-server: $schema=https://taskfile.dev/schema.json

version: "3"

vars:
  TFVARS: "{% raw %}{{.TF_DIR}}/{{.ENVIRONMENT}}{% endraw %}.auto.tfvars"
  # The script checks the {{ cloud }} login itself and starts it when needed.
  DEPLOY: "uv run --no-sync python {% raw %}{{.TF_DIR}}{% endraw %}/deploy.py"

tasks:
  # ----------------------------------------------------------------------------
  # Terraform Commands (Namespace: tf) - {{ cloud }}
  # ----------------------------------------------------------------------------
  status:
    desc: Show current deployment status
    cmd: "{% raw %}{{.DEPLOY}}{% endraw %} status"

  bootstrap:
    desc: Create state storage infrastructure in {{ cloud }} (only run once)
    requires:
      vars: [TFVARS]
    cmd: "{% raw %}{{.DEPLOY}} bootstrap --tfvars {{.TFVARS}} {{.CLI_ARGS}}{% endraw %}"

  migrate:
    desc: Deploy and update main infrastructure
    requires:
      vars: [TFVARS]
    cmd: "{% raw %}{{.DEPLOY}} migrate --tfvars {{.TFVARS}} {{.CLI_ARGS}}{% endraw %}"

  destroy:
    desc: Destroy all infrastructure (⚠️  destructive)
    requires:
      vars: [TFVARS]
    cmd: "{% raw %}{{.DEPLOY}} cleanup --tfvars {{.TFVARS}} {{.CLI_ARGS}}{% endraw %}"
