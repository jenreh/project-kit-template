PROFILES=local
#PROFILES=devcontainer
#PROFILES=docker_test
#PROFILES=prod

SECRET_PROVIDER=local        # or azure if you want to use Azure Key Vault
AZURE_KEY_VAULT_URL=https://<your-key-vault-name>.vault.azure.net/  # Optional: only needed if SECRET_PROVIDER=azure
REFLEX_SOCKET_TIMEOUT=600.   # Optional: increase the timeout for the reflex socket, e.g. if you are using a devcontainer and the reflex server is running on the host machine
UV_PROJECT_ENVIRONMENT=.venv # Optional: if using devcontainer and local development set this e.g. to .venv.mac
FORWARDED_ALLOW_IPS=127.0.0.1 # Addresses allowed to set X-Forwarded-Proto. Set this to your reverse proxy in production.

#####
# local secret provider:

# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
mn-db-encryption-key=<your fernet encryption key here>
mn-db-user=<your database user here>
mn-db-password=<your database password here>
mn-db-host=<your database host here>
mn-db-name=<your database name here>

# First administrator, read by `task admin:bootstrap`. The password has to be changed
# at first login, so remove both values again afterwards.
#mn-admin-email=<admin email address>
#mn-admin-password=<at least 12 characters with upper, lower, digit and special>

# Public URL of the deployment, needed by the prod profile, e.g. https://app.example.com
#mn-server-endpoint=<your public https url>

#####
# docker compose, only when this file is copied to .env.docker:

#PROFILES=docker_test
#FORWARDED_ALLOW_IPS=127.0.0.1
#POSTGRES_PASSWORD=<choose a database password>
#mn-db-user=postgres
#mn-db-password=<the same database password>
#mn-db-host=db
