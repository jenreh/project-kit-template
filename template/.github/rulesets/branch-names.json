{
  "name": "Enforce git-flow branch names",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "~DEFAULT_BRANCH",
        "refs/heads/develop",
        "refs/heads/feature/*",
        "refs/heads/fix/*",
        "refs/heads/hotfix/*",
        "refs/heads/docs/*",
        "refs/heads/release/*",
        "refs/heads/dependabot/**"
      ]
    }
  },
  "rules": [{ "type": "creation" }],
  "bypass_actors": []
}
