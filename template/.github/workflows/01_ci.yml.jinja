name: 01 CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-{% raw %}${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  python:
    name: Lint and test (Python)
    runs-on: ubuntu-latest
{%- if project_type == 'reflex' %}
    env:
      # Importing `app` loads the YAML configuration; the local profile plus
      # dummy secrets let it resolve without a real database or OAuth app.
      PROFILES: local
      SECRET_PROVIDER: local
      # Names follow the `secret:` references in configuration/config.yaml.
      COMMON_OAUTH_GITHUB_CLIENT_ID: ci
      COMMON_OAUTH_GITHUB_CLIENT_SECRET: ci
      COMMON_OAUTH_AZURE_CLIENT_ID: ci
      COMMON_OAUTH_AZURE_CLIENT_SECRET: ci
      COMMON_OAUTH_AZURE_TENANT_ID: ci
{%- endif %}
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Install uv
        uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          version: "0.13.8"
          enable-cache: true

      - name: Install dependencies
        run: uv sync --locked --all-packages
{%- if project_type == 'reflex' %}

      - name: Generate throwaway DB encryption key
        run: |
          key="$(uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')"
          echo "::add-mask::${key}"
          echo "COMMON_DB_ENCRYPTION_KEY=${key}" >> "$GITHUB_ENV"
{%- endif %}

      - name: Ruff lint
        run: uv run ruff check .

      - name: Ruff format
        run: uv run ruff format --check .

      - name: Pytest
        run: uv run pytest -q
{%- if project_type == 'reflex' %}

  javascript:
    name: Test (JavaScript)
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Set up Node.js
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "24"

      - name: node --test
        run: node --test "components/*/tests/js/*.test.mjs"
{%- endif %}
