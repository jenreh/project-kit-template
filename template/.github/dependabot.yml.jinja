{%- set docker_dirs = [] -%}
{%- if project_type == 'reflex' and include_docker %}{% set docker_dirs = docker_dirs + ['/'] %}{% endif -%}
{%- if use_devcontainer %}{% set docker_dirs = docker_dirs + ['/.devcontainer'] %}{% endif -%}
# Version updates wait out a cooldown, so a freshly compromised release has time to
# be found and pulled first. Security updates ignore the cooldown.
version: 2
updates:
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
      day: "monday"
      time: "09:00"
      timezone: "Europe/Berlin"
    cooldown:
      default-days: 7
    open-pull-requests-limit: 5
    labels:
      - "dependencies"
      - "github-actions"
    groups:
      github-actions:
        patterns:
          - "*"

  - package-ecosystem: "pre-commit"
    directory: "/"
    schedule:
      interval: "weekly"
    cooldown:
      default-days: 7
    open-pull-requests-limit: 3
    labels:
      - "dependencies"
      - "pre-commit"
{%- if use_devcontainer %}

  - package-ecosystem: "devcontainers"
    directory: "/"
    schedule:
      interval: "weekly"
      day: "monday"
      time: "09:00"
      timezone: "Europe/Berlin"
    cooldown:
      default-days: 7
    open-pull-requests-limit: 3
    labels:
      - "dependencies"
      - "devcontainer"
{%- endif %}
{%- if docker_dirs %}
{%- for ecosystem in ['docker', 'docker-compose'] %}

  - package-ecosystem: "{{ ecosystem }}"
    directories:
{%- for dir in docker_dirs %}
      - "{{ dir }}"
{%- endfor %}
    schedule:
      interval: "weekly"
      day: "tuesday"
      time: "09:00"
      timezone: "Europe/Berlin"
    cooldown:
      default-days: 7
    open-pull-requests-limit: 3
    labels:
      - "dependencies"
      - "docker"
{%- endfor %}
{%- endif %}

  - package-ecosystem: "uv"
    directory: "/"
    schedule:
      interval: "weekly"
    cooldown:
      default-days: 7
    open-pull-requests-limit: 10
    labels:
      - "dependencies"
      - "uv"
    # Group minor and patch updates together
    groups:
      python-minor-patch:
        patterns:
          - "*"
        update-types:
          - "minor"
          - "patch"
        exclude-patterns:
          - "reflex*"  # Keep your main framework separate
