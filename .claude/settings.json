{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"$CLAUDE_PROJECT_DIR/.claude/hooks/render_check.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
